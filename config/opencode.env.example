# Run setup to generate unique local keys; these placeholders are not credentials.
TOKEN_COUNTER_INTEGRATION_PROFILE=opencode_litellm
TOKEN_COUNTER_UPSTREAM_BASE_URL=https://gateway.example.invalid/v1
TOKEN_COUNTER_UPSTREAM_API_KEY={env:LITELLM_API_KEY}
TOKEN_COUNTER_PROVIDER_ID=bifrost-litellm
TOKEN_COUNTER_HOST=127.0.0.1
TOKEN_COUNTER_PORT=8001
TOKEN_COUNTER_AUTH_MODE=configured_upstream_key
TOKEN_COUNTER_CLIENT_KEY=<GENERATE_UNIQUE_CLIENT_KEY>
TOKEN_COUNTER_ADMIN_KEY=<GENERATE_UNIQUE_ADMIN_KEY>
TOKEN_COUNTER_CLIENT_INSTANCE_ID=opencode-local
TOKEN_COUNTER_MODEL_REGISTRY=config/models.json
TOKEN_COUNTER_DATA_DIR=runtime/opencode_litellm/data
TOKEN_COUNTER_LOG_DIR=runtime/opencode_litellm/logs
TOKEN_COUNTER_SESSION_METADATA_SOURCE=sqlite_readonly
TOKEN_COUNTER_OPENCODE_DB=<ABSOLUTE_USER_DATA_PATH>/.local/share/opencode/opencode.db
TOKEN_COUNTER_INCLUDE_STREAM_USAGE=true
TOKEN_COUNTER_CONNECT_TIMEOUT=10
TOKEN_COUNTER_IDLE_TIMEOUT=180
TOKEN_COUNTER_TOTAL_TIMEOUT=1800
TOKEN_COUNTER_HEALTH_TIMEOUT=2
TOKEN_COUNTER_HEALTH_TTL=30
